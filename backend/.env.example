# Runlete backend configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
MONGO_URL=mongodb://localhost:27017          # prod: your Atlas/managed MongoDB URI
DB_NAME=runlete_database                         # prod DB name (dev uses test_database)

# --- Security (REQUIRED) ---
JWT_SECRET=                                   # long random string; generate with: openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081   # comma-separated; add your prod app origins

# --- AI providers ---
OPENROUTER_API_KEY=                           # for meal analysis + workout generation via OpenRouter
ANTHROPIC_API_KEY=                            # for direct Anthropic calls
MEAL_AI_MODEL=openai/gpt-4o-mini
WORKOUT_AI_MODEL=claude-opus-4-8
WORKOUT_AI_MAX_TOKENS=
WORKOUT_AI_MAX_ATTEMPTS=2
WORKOUT_AI_MAX_WEEKS=1
WORKOUT_AI_STRICT_LIBRARY_MATCHES=false
WORKOUT_AI_DAILY_QUOTA=25                     # per-user rolling-24h generation cap (cost guard); 0 disables
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Runlete

# --- Error monitoring (optional) ---
SENTRY_DSN=                                   # leave blank to disable; set to enable Sentry
ENVIRONMENT=production

# --- OTP delivery (TODO: wire a provider in create_and_store_otp) ---
# Currently OTP codes are only logged to the server console. Add e.g.:
# RESEND_API_KEY=
# or SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD=
