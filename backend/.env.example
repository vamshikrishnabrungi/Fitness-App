# Runlete clean PostgreSQL/GCP runtime. Real values belong in Secret Manager.
ENVIRONMENT=development
ADMIN_STUDIO_OPEN_ACCESS=false
ADMIN_IAP_AUDIENCE=
OTP_DEBUG_ENABLED=false
CLOUD_SQL_INSTANCE=project-id:region:instance-name
CLOUD_SQL_IP_TYPE=PUBLIC
DATABASE_USER=runlete_app
DATABASE_PASSWORD=
DATABASE_NAME=runlete
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Only CI/tests may use a direct PostgreSQL URL. Application runtimes reject it.
TEST_DATABASE_URL=
REDIS_URL=rediss://managed-redis-host:6379/0

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-32-character-secret
JWT_ISSUER=runlete-api
JWT_AUDIENCE=runlete-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# GCP infrastructure
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1
RAW_ACTIVITY_BUCKET=
IMPORT_BUCKET=
EXERCISE_MEDIA_BUCKET=
NUTRITION_IMAGE_BUCKET=
EXPORT_BUCKET=
VALHALLA_GRAPH_BUCKET=
KMS_KEY_NAME=
# OpenAI Responses API. Store the production value in Secret Manager.
OPENAI_API_KEY=
# Constrained workout selection and food vision remain independently configurable.
OPENAI_WORKOUT_MODEL=gpt-5.6-terra
OPENAI_FOOD_MODEL=gpt-4o

# Maps and matching
MAPBOX_PUBLIC_TOKEN=
VALHALLA_URL=
# Production uses region codes matching activity.osm_regions.code, for example:
# VALHALLA_URLS_JSON={"india":"http://10.0.0.10:8002","uk":"http://10.0.0.11:8002","us":"http://10.0.0.12:8002"}

# Transactional email and optional error monitoring
RESEND_API_KEY=
RESEND_FROM=Runlete <noreply@runlete.com>
EMAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
INFO_EMAIL_USER=
INFO_EMAIL_PASS=
SMTP_FROM_NAME=Runlete
SENTRY_DSN=
EXPO_ACCESS_TOKEN=

# Keep false until an immutable content release passes all gates. Development
# may enable this after importing, validating, and publishing a released reference dataset.
TRAINING_GENERATION_ENABLED=false
