  "core_principles": [
    {
      "id": "kickboxing_principle_base_before_output",
      "domain": "kickboxing_stance_guard",
      "summary": "Every strike, entry, exit, and defensive reaction must finish in a stance that can move, guard, check, kick, or punch again.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md"]
    },
    {
      "id": "kickboxing_principle_rule_set_shapes_stance",
      "domain": "kickboxing_stance_guard",
      "summary": "Point fighting can tolerate a more bladed, bounce-oriented stance; low-kick and K-1 users need a stance that protects the lead leg and allows checking.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md", "WAKO Rules and Discipline Structure", "GLORY Official Rules"]
    },
    {
      "id": "kickboxing_principle_range_is_defense",
      "domain": "kickboxing_range_management",
      "summary": "Range control prevents unnecessary exchanges; long kick range, boxing range, pocket range, brief tie-up range, and reset range each require different movement choices.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md"]
    },
    {
      "id": "kickboxing_principle_exit_is_part_of_attack",
      "domain": "kickboxing_combinations_entries_exits",
      "summary": "A combination is incomplete until the athlete has recovered stance, guard, range, and angle.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md"]
    },
    {
      "id": "kickboxing_principle_ringcraft_is_space_management",
      "domain": "kickboxing_footwork_ringcraft",
      "summary": "Ringcraft is not just circling; it is choosing center, steering lanes, denying exits, recovering under pressure, and avoiding the ropes and corners.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md", "GLORY Official Rules"]
    },
    {
      "id": "kickboxing_principle_style_is_a_movement_bias",
      "domain": "kickboxing_style_differences",
      "summary": "Style changes preferred range and movement rhythm, but beginners still need the same base stance, guard, and exit standards.",
      "source_refs": ["KICKBOXING_UNDERSTANDING_BRIEF.md"]
    }
  ],
