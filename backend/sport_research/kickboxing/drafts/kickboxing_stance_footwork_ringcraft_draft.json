  "training_rules": [
    {
      "id": "kickboxing_rule_stance_before_speed",
      "domain": "kickboxing_stance_guard",
      "condition": "User is learning any movement, entry, or exit pattern",
      "rule": "Increase speed only while stance width, guard, balance, and return-to-stance quality remain stable.",
      "recommended_action": ["slow_shadow_rounds", "mirror_footwork", "pad_drills_with_reset"],
      "blocked_action": ["fast_bounce_with_crossed_feet", "fatigue_drills_that_destroy_base"]
    },
    {
      "id": "kickboxing_rule_low_kick_stance_not_too_bladed",
      "domain": "kickboxing_stance_guard",
      "condition": "rule_set is low_kick, kick_light, or k1",
      "rule": "Do not use an overly bladed stance that leaves the lead leg unavailable for checking or withdrawal.",
      "recommended_action": ["balanced_stance", "check_ready_weight_distribution", "step_out_low_kick_defense"],
      "blocked_action": ["point_fighting_blade_as_default", "lead_leg_overload"]
    },
    {
