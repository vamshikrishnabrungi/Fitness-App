    {
      "id": "kickboxing_rule_open_stance_simple_first",
      "domain": "kickboxing_southpaw_orthodox",
      "condition": "User is new to orthodox/southpaw matchups",
      "rule": "Teach stance recognition, power-side awareness, and base preservation before outside-foot battles or stance traps.",
      "recommended_action": ["stance_callouts", "open_stance_shadow_steps", "rear_side_awareness_drill"],
      "blocked_action": ["complex_southpaw_traps", "chasing_outside_foot"]
    },
    {
      "id": "kickboxing_rule_unknown_ruleset_safe_movement_default",
      "domain": "kickboxing_footwork_ringcraft",
      "condition": "rule_set is unknown",
      "rule": "Default to general kickboxing stance, guard, step-slide, simple range control, basic entries/exits, and no hard sparring, extended clinch, or heavy low-kick assumptions.",
      "recommended_action": ["stance_guard", "step_slide", "range_callouts", "controlled_bag_pad_movement"],
      "blocked_action": ["hard_sparring_default", "extended_clinch_default", "low_kick_attrition_default"]
    }
  ],
  "planning_rules": [
    {
      "id": "kickboxing_plan_beginner_movement_block",
      "domain": "kickboxing_level_progression",
      "condition": "level is beginner",
      "planning_rule": "Each technical week should include stance/guard reset, basic footwork, range awareness, and one entry-exit habit before adding more combination complexity.",
      "session_bias": ["shadow", "bag_or_pad_technical", "mirror_footwork", "low_contact_partner_drills"],
      "avoid": ["hard_sparring", "corner_pressure_contact", "advanced_switch_stance"]
    },
    {
      "id": "kickboxing_plan_rule_set_movement_bias",
      "domain": "kickboxing_style_differences",
      "condition": "rule_set is known",
      "planning_rule": "Bias movement drills toward the selected rule set: point fighting uses first-step and exits; low-kick/K-1 uses check-ready stance and ring pressure; full contact uses volume movement and angle exits.",
      "session_bias": ["rule_set_specific_footwork", "rule_set_range_calls", "rule_set_exit_constraints"],
      "avoid": ["one_size_fits_all_kickboxing_movement"]
    },
    {
      "id": "kickboxing_plan_style_without_locking_beginner",
      "domain": "kickboxing_style_differences",
      "condition": "style is selected but level is beginner",
      "planning_rule": "Use style as a light drill flavor, not as a narrow identity, until stance, guard, basic footwork, and exits are reliable.",
      "session_bias": ["base_tools_first", "one_style_flavored_drill"],
      "avoid": ["advanced_style_specialization", "style_that_bypasses_defense"]
    },
    {
      "id": "kickboxing_plan_rope_corner_contact_gate",
      "domain": "kickboxing_ropes_corner_control",
      "condition": "Program includes ropes or corner control",
      "planning_rule": "Progress from spatial awareness to non-contact escape, then technical pressure, then live scenarios only if contact level and skill gates permit.",
      "session_bias": ["ring_zone_callouts", "pad_pressure", "technical_partner_pressure"],
      "avoid": ["unscaffolded_corner_sparring"]
    },
    {
      "id": "kickboxing_plan_fatigue_simplifies_footwork",
      "domain": "kickboxing_footwork_ringcraft",
      "condition": "late round, conditioning round, or user shows fatigue errors",
      "planning_rule": "Simplify to guard, short step-slide, jab or probe, pivot, and reset instead of complex switch or angle chains.",
      "session_bias": ["simple_exit_under_fatigue", "guard_recovery", "short_step_quality"],
      "avoid": ["fatigued_spinning_or_switching", "large_crossing_steps"]
    },
    {
      "id": "kickboxing_plan_southpaw_orthodox_exposure",
      "domain": "kickboxing_southpaw_orthodox",
      "condition": "User is intermediate or preparing for sparring/competition",
      "planning_rule": "Include regular but bounded exposure to opposite-stance movement, power-side awareness, and open-stance exits.",
      "session_bias": ["stance_callouts", "open_stance_entries", "lead_foot_relation", "exit_after_rear_side_attack"],
      "avoid": ["open_stance_work_without_base", "foot_clash_heavy_drills"]
    }
  ],
  "skill_assessments": [
    {
      "id": "kickboxing_assess_stance_guard_recovery",
      "domain": "kickboxing_stance_guard",
      "level": "beginner",
      "test": "Two 2-minute technical rounds of shadow or pad movement with stance resets after every strike.",
      "pass_criteria": ["guard_returns_after_actions", "feet_do_not_cross", "stance_width_recovers", "chin_stays_protected", "balance_survives_misses"],
      "fail_flags": ["hands_drop", "falls_forward_after_kick", "lands_square", "feet_too_narrow"]
    },
    {
      "id": "kickboxing_assess_step_slide_pivot",
      "domain": "kickboxing_footwork_ringcraft",
      "level": "beginner_to_intermediate",
      "test": "Coach/app calls forward, back, left, right, pivot, and reset for 90 seconds.",
      "pass_criteria": ["nearest_foot_moves_first", "short_steps", "guard_maintained", "can_pivot_without_knee_collapse", "no_repeated_straight_retreat"],
      "fail_flags": ["crossing_feet", "hopping_tall", "turning_back", "losing_stance_after_pivot"]
    },
    {
      "id": "kickboxing_assess_range_entry_exit",
      "domain": "kickboxing_range_management",
      "level": "intermediate",
      "test": "Partner or pad holder gives range cues; athlete enters, completes a simple action, defends or resets, and exits on command.",
      "pass_criteria": ["recognizes_long_kick_boxing_pocket_reset_ranges", "entry_has_setup", "exit_is_planned", "guard_survives_exit"],
      "fail_flags": ["enters_without_setup", "overstays_pocket", "backs_straight_to_ropes", "no_defensive_recovery"]
    },
    {
      "id": "kickboxing_assess_ringcraft_zones",
      "domain": "kickboxing_ropes_corner_control",
      "level": "intermediate",
      "test": "Technical round with center, ropes, and corner zone calls; athlete must reclaim center or trap safely depending on role.",
      "pass_criteria": ["knows_ring_zone", "escapes_before_corner_when_mover", "cuts_exit_when_pressure", "does_not_chase", "uses_frame_or_pivot_on_ropes"],
      "fail_flags": ["straight_line_retreat", "passive_shell_on_ropes", "chasing_runner", "unsafe_corner_contact"]
    },
    {
      "id": "kickboxing_assess_southpaw_orthodox_iq",
      "domain": "kickboxing_southpaw_orthodox",
      "level": "intermediate_to_advanced",
      "test": "Stance recognition and open-stance movement round with orthodox/southpaw switches by partner.",
      "pass_criteria": ["identifies_stance", "tracks_power_side", "keeps_base", "uses_safe_outside_angle", "exits_after_open_stance_entry"],
      "fail_flags": ["foot_clash", "crossing_to_win_outside_foot", "ignores_rear_side_threat", "freezes_after_stance_switch"]
    },
    {
      "id": "kickboxing_assess_style_movement_fit",
      "domain": "kickboxing_style_differences",
      "level": "intermediate_to_advanced",
      "test": "Athlete performs one round each as outfighter, pressure fighter, and counter fighter with movement goals tracked.",
      "pass_criteria": ["can_change_range_plan", "understands_style_vulnerability", "movement_matches_style_goal", "can_return_to_base_when_style_fails"],
      "fail_flags": ["style_becomes_identity_excuse", "pressure_chases", "outfighter_runs_to_ropes", "counter_fighter_waits_passively"]
    }
  ],
  "level_transition_rules": [
    {
      "id": "kickboxing_transition_beginner_to_intermediate_movement",
      "from_level": "beginner",
      "to_level": "intermediate",
      "required_competencies": [
        "stable_stance_guard_for_multiple_rounds",
        "step_slide_all_directions_without_crossing_feet",
        "basic_pivot_or_angle_exit",
        "return_to_stance_after_basic_punch_or_kick",
        "understands_no_hard_sparring_default"
      ],
      "unlocks": ["basic_ringcraft", "controlled_partner_pressure", "simple_open_stance_awareness", "rule_set_specific_exit_drills"],
      "blocked_if": ["guard_drops_under_movement", "lands_square_after_kicks", "retreats_straight_back_by_default"]
