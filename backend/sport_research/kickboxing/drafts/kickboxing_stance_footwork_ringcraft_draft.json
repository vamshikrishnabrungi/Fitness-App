        "style_vulnerability_identified_and_trained"
      ],
      "unlocks": ["opponent_specific_ringcraft", "corner_trap_scenarios", "advanced_open_stance_tactics", "score_state_movement_plan"],
      "blocked_if": ["unsafe_corner_contact", "open_stance_foot_clashes_persist", "fatigue_causes_crossed_feet_or_guard_loss"]
    },
    {
      "id": "kickboxing_transition_style_specialization_gate",
      "from_level": "general_base",
      "to_level": "style_specialization",
      "required_competencies": [
        "base_stance_and_guard_reliable",
        "can_use_at_least_two_ranges",
        "has_safe_entry_and_exit",
        "can_name_style_risks",
        "rule_set_selected_or_clearly_assumed"
      ],
      "unlocks": ["point_fighter_movement_block", "outfighter_ringcraft_block", "pressure_ring_cutting_block", "counter_fighter_timing_block", "k1_ring_control_block"],
      "blocked_if": ["beginner_base_unstable", "style_selection_used_to_skip_defense", "rule_set_unknown_but_advanced_rule_specific_tactics_requested"]
    },
    {
      "id": "kickboxing_transition_rope_corner_live_gate",
      "from_level": "technical_rope_work",
      "to_level": "live_rope_corner_scenarios",
      "required_competencies": [
        "known_exit_options",
        "contact_level_at_least_technical_sparring",
        "coach_supervision_available",
        "guard_and_composure_under_pressure",
        "clear_stoppage_rules"
      ],
      "unlocks": ["live_pressure_escape", "corner_trap_defense", "pressure_fighter_cutoff_rounds"],
      "blocked_if": ["fitness_kickboxing_no_sparring", "head_contact_risk_unmanaged", "beginner_no_exit_skill"]
    },
    {
      "id": "kickboxing_transition_switch_stance_gate",
      "from_level": "single_stance_base",
      "to_level": "switch_stance_or_advanced_open_stance",
      "required_competencies": [
        "orthodox_or_southpaw_base_stable",
        "can_recognize_open_and_closed_stance",
        "can_move_without_crossing_feet",
        "guard_survives_stance_change",
        "understands_power_side_changes"
      ],
      "unlocks": ["stance_switch_drills", "open_stance_traps", "opponent_specific_stance_plan"],
      "blocked_if": ["switching_causes_square_stance", "foot_clashes_common", "user_loses_guard_after_switch"]
    }
