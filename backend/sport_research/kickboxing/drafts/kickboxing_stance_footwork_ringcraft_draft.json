      "domain": "kickboxing_combinations_entries_exits",
      "condition": "rule_set is point_fighting",
      "rule": "Prioritize explosive entry, clean touch, and fast exit over continuous pocket exchange or attritional pressure.",
      "recommended_action": ["first_step_drills", "lead_leg_probe_exit", "blitz_exit_reset"],
      "blocked_action": ["long_pocket_exchange_default", "heavy_low_kick_attrition_default"]
    },
    {
      "id": "kickboxing_rule_exit_after_every_combination",
      "domain": "kickboxing_combinations_entries_exits",
      "condition": "User trains combinations",
      "rule": "Every combination should end with stance recovery, defensive responsibility, and either an angle, step-out, or range reset.",
