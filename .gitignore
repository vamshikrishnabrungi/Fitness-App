**/.pytest_cache/

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel
deploy/rendered/*.yaml
deploy/rendered/*.json

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
model.patch
test_result.md

# Build caches
.cache/
.metro-cache/
**/.metro-cache/

# Mobile development
android-sdk/

# Environment files
*.env
*.env.*
.env
.env.*
credentials.json
*.key
.credentials

# --- Large / copyrighted reference source material (keep OUT of git history) ---
/*.pdf
/*.epub
/*.jpeg
/*.jpg
/*.webp
/pylometrics/

# AI generation scratch artifacts
backend/anthropic_week1_*.json
backend/openrouter_week1_*.json

# ...but DO track the env template (overrides the *.env.* rule above)
!backend/.env.example
!frontend/.env.example

# Local API key scratch — never commit
backend/openai_keys_to_test.txt

# Terraform/OpenTofu local provider and state cache
**/.terraform/
